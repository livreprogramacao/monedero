<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
    Section: properties details
    -->
    <groupId>org.apache.kafka.monedero</groupId>
    <artifactId>monedero</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>monedero</name>
    <description>Monedero, is a fictional company whose core business is cryptocurrency exchange.</description>
    <url>https://github.com/livreprogramacao/monedero</url>
    <!--
    Section: licenses details
    -->
    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A permissive license allowing the software to be used freely.</comments>
        </license>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
            <comments>A simple and easy-to-understand license.</comments>
        </license>
    </licenses>
    <!--
    Section: developers details
    -->
    <developers>
        <developer>
            <id>john.doe</id>
            <name>John Doe</name>
            <email>john.doe@example.com</email>
            <url>http://johndoe.com</url>
            <organization>Example Corp</organization>
            <organizationUrl>http://example.com</organizationUrl>
            <roles>
                <role>lead</role>
                <role>developer</role>
            </roles>
            <timezone>UTC-5</timezone>
        </developer>
        <developer>
            <id>jane.smith</id>
            <name>Jane Smith</name>
            <email>jane.smith@example.com</email>
            <url>http://janesmith.com</url>
            <organization>Tech Solutions</organization>
            <organizationUrl>http://techsolutions.com</organizationUrl>
            <roles>
                <role>developer</role>
                <role>tester</role>
            </roles>
            <timezone>UTC+0</timezone>
        </developer>
    </developers>
    <!--
    Section: scm details
    -->
    <scm>
        <connection>scm:git:git://github.com/livreprogramacao/monedero.git</connection>
        <developerConnection>scm:git:ssh://github.com/livreprogramacao/monedero.git</developerConnection>
        <tag>v0.0.1</tag>
        <url>https://github.com/livreprogramacao/monedero</url>
    </scm>
    <!--
    Section: properties details
    -->
    <properties>
        <h2.version>2.4.240</h2.version>
        <hibernate.core.version>5.4.32.Final</hibernate.core.version>
        <java.version>25</java.version>
        <javax.persistence.api.version>2.2</javax.persistence.api.version>
        <junit.version>5.7.2</junit.version>
        <log4j.version>2.14.1</log4j.version>
        <lombok.version>1.18.42</lombok.version>
        <main.class>com.github.livreprogramacao.monedero.App</main.class> <!-- Define your main class here -->
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <slf4j.api.version>1.7.36</slf4j.api.version>
        <mapstruct.version>1.6.3</mapstruct.version>
    </properties>
    <!--
    Section: dependencies details
    -->
    <dependencies>
        <!-- Mapstruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>${mapstruct.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Jakarta Validator -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>2.0.2</version>
        </dependency>
        <!-- SLF4J API -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.api.version}</version> <!-- Use the latest version -->
        </dependency>
        <!-- SLF4J Implementation -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-log4j12</artifactId>
            <version>${slf4j.api.version}</version> <!-- Log4j binding -->
        </dependency>
        <!-- Lombok set up -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version> <!-- Check for the latest version -->
            <scope>compile</scope>
        </dependency>
        <!-- JPA Dependency -->
        <dependency>
            <groupId>javax.persistence</groupId>
            <artifactId>javax.persistence-api</artifactId>
            <version>${javax.persistence.api.version}</version>
        </dependency>
        <!-- JPA Implementation (Hibernate) -->
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.core.version}</version>
        </dependency>
        <!-- H2 Database Dependency -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
    <!--
    Section: build
    The <build> section is essential for defining how your project should be compiled, packaged, and tested.
    This section enables you to configure various plugins crucial for building your application effectively.
    Proper configuration of this section can optimize your build process and streamline development workflows.
    -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>