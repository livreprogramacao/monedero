# Enable Lombok's configuration settings
# This tells Lombok to look for configuration in this file
lombok.add lombok.config = true

# Configure the logger declaration for CustomLog
# Replace <YourClassName> with the appropriate class name
log.custom.declaration = org.slf4j.Logger log = org.slf4j.LoggerFactory.getLogger(this.getClass())

# Other optional configurations
# Enable experimental features (if needed)
lombok.experimental.features = true

# Configure access levels (default is public for Lombok)
lombok.getter.noIsPrefix = true
lombok.setter.nonPrivate = true

# Possible settings for usage in specific cases
lombok.logging.level = INFO  # Set logging level for Lombok annotations